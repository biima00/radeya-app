generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String       @id @default(uuid())
  name          String
  email         String       @unique
  password      String
  emailVerified Boolean      @default(false)
  role          String       @default("MEMBER")
  orgId         String
  org           Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([orgId])
}

model Organization {
  id                   String    @id @default(uuid())
  name                 String
  plan                 String          @default("FREE")
  subscriptionActive   Boolean         @default(false)
  subscriptionEnd      DateTime?
  lastPaymentOrderId   String?         // ADDED CLAUDE AI: Idempotency key for webhook deduplication
  users                User[]
  cycles               Cycle[]
  inventoryItems       InventoryItem[]
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt
}

model Cycle {
  id        String           @id @default(uuid())
  name      String
  animal    String
  scale     Int
  mode      String
  data      Json             @default("{}")
  orgId     String
  org       Organization     @relation(fields: [orgId], references: [id], onDelete: Cascade)
  animals   AnimalIdentity[]
  inventoryUsages InventoryUsage[]
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@index([orgId])
}

model AnimalIdentity {
  id         String            @id @default(uuid())
  cycleId    String
  cycle      Cycle             @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  earTag     String
  rfidTag    String?           @unique
  gender     String            // "MALE" | "FEMALE"
  birthDate  DateTime?
  breed      String?
  fatherTag  String?
  motherTag  String?
  status     String            @default("ACTIVE") // "ACTIVE" | "INACTIVE" etc.
  treatments AnimalTreatment[]
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt

  @@index([cycleId])
}

model AnimalTreatment {
  id             String         @id @default(uuid())
  animalId       String
  animal         AnimalIdentity @relation(fields: [animalId], references: [id], onDelete: Cascade)
  diagnose       String
  medicineName   String
  dosage         String
  withdrawalDays Int            @default(0)
  notes          String?
  treatmentDate  DateTime       @default(now())
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([animalId])
}

model InventoryItem {
  id          String           @id @default(uuid())
  name        String
  category    String           // "FEED" | "MEDICINE" | "EQUIPMENT"
  stock       Float
  unit        String
  minAlert    Float            @default(5.0)
  costPerUnit Float
  orgId       String
  org         Organization     @relation(fields: [orgId], references: [id], onDelete: Cascade)
  usages      InventoryUsage[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([orgId])
}

model InventoryUsage {
  id        String        @id @default(uuid())
  itemId    String
  item      InventoryItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  cycleId   String
  cycle     Cycle         @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  qtyUsed   Float
  notes     String?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([itemId])
  @@index([cycleId])
}
